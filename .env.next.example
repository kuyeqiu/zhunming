# 新版应用（mingyu-next）环境变量示例
# 复制为 .env.local 后填真实值；该文件不提交、权限 600。

# ---- 监听 ----
# 只监听环回：外面由 nginx 反代。若要直接对外再加安全组放行。
HOST=127.0.0.1
PORT=3200
# 对外 origin，用于分享链接与 CORS 判定（可选）
# MINGYU_PUBLIC_ORIGIN=https://your.domain

# ---- 数据 ----
# 账号 / 订单 / 权益 / 兑换码 的 SQLite 位置
MINGYU_DATA_DIR=/zhunming-next/.data

# ---- 账号 ----
# 用这个邮箱注册的第一个账号会成为管理员；留空则不自动授予
MINGYU_BOOTSTRAP_ADMIN_EMAIL=

# ---- 收费 ----
# 关闭后 AI 解读不限次（自部署逃生口）
MINGYU_PAYWALL_ENABLED=true
# 未登录/非会员每日免费 AI 解读次数
MINGYU_FREE_AI_DAILY=3

# ---- AI（走服务端代理时必填）----
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=
